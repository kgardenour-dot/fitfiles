{
  "expo": {
    "name": "ChefLinks",
    "slug": "cheflinks",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/cheflinks_app_logo.png",
    "userInterfaceStyle": "light",
    "scheme": "cheflinks",
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "buildNumber": "19",
      "icon": "./assets/cheflinks_app_logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.banditinnovations.cheflinks",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.banditinnovations.cheflinks"
        ]
      }
    },
    "android": {
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/cheflinks_app_logo.png",
        "backgroundColor": "#0B1220"
      },
      "package": "com.banditinnovations.cheflinks"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.banditinnovations.cheflinks"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8416a56-a039-4b02-bbdb-ad070e7869b6"
      }
    },
    "owner": "kgardenour-dot"
  }
}
